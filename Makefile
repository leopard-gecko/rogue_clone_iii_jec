# Select the native Windows port from the MSYS2 UCRT64 shell.  Override
# with ROGUE_BUILD=unix if building in a POSIX-like shell on Windows.
ifeq ($(strip $(ROGUE_BUILD)),)
ifeq ($(MSYSTEM),UCRT64)
ROGUE_BUILD := windows
else ifeq ($(OS),Windows_NT)
ifeq ($(strip $(MSYSTEM)),)
ROGUE_BUILD := windows
else
ROGUE_BUILD := unix
endif
else
ROGUE_BUILD := unix
endif
endif

ifeq ($(ROGUE_BUILD),windows)
include Makefile.win
else ifeq ($(ROGUE_BUILD),unix)
# Makefile for Rogue Clone III (4.3BSD-Tahoe source), modern Unix build
#
# Default build uses the system curses/ncurses library:
#     ./configure
#     make
#
# You can also build without configure:
#     make
#
# On macOS this defaults to -lncurses.  On Linux and other Unix-like systems
# this defaults to -lncursesw for better UTF-8/wide-character terminal support.
# If your system needs a different curses library, override CURSES_LIB:
#     make CURSES_LIB=-lncurses
#
# Unified bilingual build:
#     make
# Startup language: ROGUEOPTS=language=ja|en|auto overrides the build
# default (DEFAULT_LANGUAGE=0 auto, 1 Japanese, 2 English).  With auto,
# the OS locale selects the initial language.
# During play the options screen offers Japanese and English only.
#
# Builds with a fixed English or Japanese default language:
#     make english
#     make original
#     make japanese
#
# The default build uses the modern terminal defaults used by this port:
# jump off, passgo on, color on, cursor off, and ALLSCORES on.
#
# To build with defaults closer to the original Clone III and English text:
#     make original
#
# You can override these explicitly, for example:
#     make DEFAULT_JUMP=1 DEFAULT_PASSGO=0 DEFAULT_COLOR=0 DEFAULT_CURSOR=1 ALLSCORES=0
#
# To place generated save/score/lock files in a single directory:
#     make FILEDIR=/path/to/dir

CC ?= cc
UNAME_S := $(shell uname -s)
DEFAULT_LANGUAGE ?= 0
ALLSCORES ?= 1
DEFAULT_JUMP ?= 0
DEFAULT_PASSGO ?= 1
DEFAULT_COLOR ?= 1
DEFAULT_CURSOR ?= 0
PROG ?=
PROGRAM ?= rogue-clone
DIST_NAME ?= rogue-clone-iii-004-src
DIST_FILE ?= ../$(DIST_NAME).tar.gz
PREFIX ?= /usr/local
BINDIR ?= $(PREFIX)/bin
DOCDIR ?= $(PREFIX)/share/doc/$(PROGRAM)
CURSES_CFLAGS ?=
FILEDIR ?=

# Generated by ./configure when present.  Command-line make variables still
# take precedence over values in config.mk.
-include config.mk

ifneq ($(strip $(PROG)),)
PROGRAM := $(PROG)
endif

# make original defaults to the original English build, but an explicit
# command-line DEFAULT_LANGUAGE override is preserved so that commands such as
# "make original DEFAULT_LANGUAGE=1" build an original-style Japanese binary.
ifeq ($(origin DEFAULT_LANGUAGE),command line)
ORIGINAL_DEFAULT_LANGUAGE := $(DEFAULT_LANGUAGE)
else
ORIGINAL_DEFAULT_LANGUAGE := 2
endif

ifneq ($(strip $(FILEDIR)),)
SAVEFILE ?= $(FILEDIR)/$(PROGRAM).save
SCOREFILE ?= $(FILEDIR)/$(PROGRAM).scores
LOCKFILE ?= $(FILEDIR)/$(PROGRAM).lock
else
SAVEFILE ?= $(PROGRAM).save
SCOREFILE ?= $(PROGRAM).scores
LOCKFILE ?= $(PROGRAM).lock
endif

LANG_DEFS = -DDEFAULT_LANGUAGE=$(DEFAULT_LANGUAGE)
OPTION_DEFS = -DDEFAULT_JUMP=$(DEFAULT_JUMP) \
	-DDEFAULT_PASSGO=$(DEFAULT_PASSGO) \
	-DDEFAULT_COLOR=$(DEFAULT_COLOR) \
	-DDEFAULT_CURSOR=$(DEFAULT_CURSOR)

ifeq ($(UNAME_S),Darwin)
CURSES_LIB ?= -lncurses
else
CURSES_LIB ?= -lncursesw
endif

LDLIBS += $(CURSES_LIB)

ifeq ($(ALLSCORES),1)
SCORE_DEFS = -DALLSCORES
else
SCORE_DEFS =
endif

PROGRAM_DEFS = -DROGUE_PROGRAM_NAME=\"$(PROGRAM)\" \
	-DDEFAULT_SAVE_FILE=\"$(SAVEFILE)\" \
	-DSCORE_FILE=\"$(SCOREFILE)\" \
	-DLOCK_FILE=\"$(LOCKFILE)\"

CPPFLAGS += -I. $(CURSES_CFLAGS) $(LANG_DEFS) $(OPTION_DEFS) $(SCORE_DEFS) $(PROGRAM_DEFS)
CFLAGS ?= -std=gnu89 -O2 -DUNIX -DMODERN_UNIX

INSTALL ?= install
INSTALL_PROGRAM ?= $(INSTALL) -m 755
INSTALL_DATA ?= $(INSTALL) -m 644

SRCS= jec/color.c hit.c init.c inventory.c jec/language.c level.c machdep.c main.c \
	message.c monster.c move.c object.c pack.c play.c random.c ring.c \
	jec/unicode_text.c room.c save.c score.c spec_hit.c throw.c trap.c use.c zap.c
OBJS= $(SRCS:.c=.o)

.DEFAULT_GOAL := all

all: $(PROGRAM)

$(PROGRAM): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS) $(LDLIBS)

$(OBJS): Makefile rogue.h jec/color.h jec/rogue_i18n.h jec/unicode_text.h $(wildcard config.mk)

japanese:
	$(MAKE) clean
	$(MAKE) DEFAULT_LANGUAGE=1

english:
	$(MAKE) clean
	$(MAKE) DEFAULT_LANGUAGE=2

original:
	$(MAKE) clean
	$(MAKE) DEFAULT_LANGUAGE=$(ORIGINAL_DEFAULT_LANGUAGE) DEFAULT_JUMP=1 DEFAULT_PASSGO=0 DEFAULT_COLOR=0 DEFAULT_CURSOR=1 ALLSCORES=0

install: $(PROGRAM)
	mkdir -p "$(DESTDIR)$(BINDIR)" "$(DESTDIR)$(DOCDIR)"
	@if [ -n "$(strip $(FILEDIR))" ]; then \
		mkdir -p "$(DESTDIR)$(FILEDIR)"; \
	fi
	$(INSTALL_PROGRAM) "$(PROGRAM)" "$(DESTDIR)$(BINDIR)/$(PROGRAM)"
	$(INSTALL_DATA) README_mac_linux_ja.md "$(DESTDIR)$(DOCDIR)/README_mac_linux_ja.md"
	$(INSTALL_DATA) README_mac_linux_en.md "$(DESTDIR)$(DOCDIR)/README_mac_linux_en.md"
	$(INSTALL_DATA) README_windows_ja.md "$(DESTDIR)$(DOCDIR)/README_windows_ja.md"
	$(INSTALL_DATA) README_windows_en.md "$(DESTDIR)$(DOCDIR)/README_windows_en.md"

uninstall:
	rm -f "$(DESTDIR)$(BINDIR)/$(PROGRAM)"
	rm -f "$(DESTDIR)$(DOCDIR)/README_mac_linux_ja.md" \
	      "$(DESTDIR)$(DOCDIR)/README_mac_linux_en.md" \
	      "$(DESTDIR)$(DOCDIR)/README_windows_ja.md" \
	      "$(DESTDIR)$(DOCDIR)/README_windows_en.md"
	-rmdir "$(DESTDIR)$(DOCDIR)" 2>/dev/null || true

# Only known source, header, document and Windows resource files are shipped.
# Take the Unix build's SRCS as the base, and explicitly add the Windows port.
# This avoids picking up local saves, scores, logs or unrelated files.
DIST_CFILES = $(sort $(SRCS) windows/machdep_win.c \
    windows/rogue_windows.c windows/rogue_windows_console.c)
DIST_HEADERS = rogue.h jec/color.h jec/rogue_i18n.h jec/unicode_text.h \
    windows/rogue_windows.h windows/rogue_windows_console.h
DIST_SUPPORT = Makefile Makefile.win configure LICENSE.txt \
    README_mac_linux_ja.md README_mac_linux_en.md \
    README_windows_ja.md README_windows_en.md \
    windows/rogue-icon.rc windows/rogue-clone-iii.ico \
    windows/windows-saved-games.ps1
DIST_FILES = $(sort $(DIST_CFILES) $(DIST_HEADERS) $(DIST_SUPPORT))

# Do not run clean here: building a source archive must never touch local game
# data or binaries.  COPYFILE_DISABLE and --no-xattrs prevent macOS metadata
# from producing GNU tar warnings on Linux, while preserving configure's mode.
dist.src:
	@set -eu; \
	  name='$(DIST_NAME)'; \
	  case "$$name" in ''|.|..|*/*) echo "Invalid DIST_NAME: $$name" >&2; exit 1;; esac; \
	  output='$(DIST_FILE)'; \
	  if [ -z "$$output" ]; then echo 'DIST_FILE must not be empty' >&2; exit 1; fi; \
	  stage=$$(mktemp -d); \
	  output_tmp="$$output.tmp.$$$$"; \
	  trap 'rm -rf "$$stage"; rm -f "$$output_tmp"' EXIT HUP INT TERM; \
	  export COPYFILE_DISABLE=1; \
	  mkdir -p "$$stage/$$name"; \
	  for file in $(DIST_FILES); do \
	    if [ ! -f "$$file" ]; then echo "Missing source file: $$file" >&2; exit 1; fi; \
	    mkdir -p "$$stage/$$name/$$(dirname "$$file")"; \
	    cp "$$file" "$$stage/$$name/$$file"; \
	  done; \
	  chmod 755 "$$stage/$$name/configure"; \
	  tar --no-xattrs -cf "$$stage/source.tar" -C "$$stage" "$$name"; \
	  gzip -n -c "$$stage/source.tar" > "$$output_tmp"; \
	  mv -f "$$output_tmp" "$$output"; \
	  echo "Created $$output"

# Build artifacts only. Never remove *.save, *.scores, *.lock or other game data.
clean:
	rm -f *.o jec/*.o windows/*.o *.win.o jec/*.win.o windows/*.win.o \
		core a.out a.exe a.exe.stackdump rogue rogueclone3 rogueclone3j \
		rogue-clone "$(PROGRAM)" "$(PROGRAM).exe" \
		conftest conftest.c conftest.o conftest.err

distclean: clean
	rm -f config.mk config.log

.PHONY: all japanese english original install uninstall dist.src clean distclean

else
$(error ROGUE_BUILD must be windows or unix)
endif
